    "operations": [
      {
        "id": "scrape",
        "method": "post",
        "path": "/scrape",
        "summary": "Scrapes a URL using Chrome browser TLS fingerprinting without executing JavaScript. Use this endpoint for pages that do not require client-side rendering, and set `headers`, `geo`, or `proxy` to customize the request. The response includes the HTML body and request metadata.",
        "description": "Use high-performance web scraping endpoint with Chrome browser TLS fingerprint, but without JavaScript execution and real browser overhead.",
        "deprecated": false,
        "deprecationMessage": null,
        "parameters": []
      },
      {
        "id": "scrapeJs",
        "method": "post",
        "path": "/scrape-js",
        "summary": "Scrapes a URL with a real Chrome browser engine to render JavaScript-dependent pages. Use this endpoint when `/scrape` does not retrieve the required page content; set `waitForSelector` or `postWaitTime` when you need to control when page loading is considered complete. The response includes the rendered HTML and browser metadata.",
        "description": "Launches real Chrome browser engine, use only when /scrape endpoint features are not enough.",
        "deprecated": false,
        "deprecationMessage": null,
        "parameters": []
      },
      {
        "id": "scrapeJsV2",
        "method": "post",
        "path": "/v2/scrape-js",
        "summary": "Scrapes a URL with the newer real Chrome browser engine to render JavaScript-dependent pages. Use this endpoint when browser rendering is required, including for sites protected by services such as Cloudflare, Datadome, Kasada, or PerimeterX. Access is available only through APIRoad.",
        "description": "Launches real Chrome browser engine, better success rate for websites protected by Cloudflare, Datadome, Kasada, PermimeterX. ATTENTION: Only available via APIRoad!",
        "deprecated": false,
        "deprecationMessage": null,
        "parameters": []
      }
